+/* cs2mac: the window whose client view is stretched, and the two rects (top-down screen coordinates)
+ * mouse input is mapped between. Main thread only. */
+static WineWindow* stretch_window;
+static CGRect stretch_full, stretch_src;
+
+static CGPoint map_point(CGPoint p, CGRect from, CGRect to)
+{
+    p.x = to.origin.x + (p.x - from.origin.x) * to.size.width / from.size.width;
+    p.y = to.origin.y + (p.y - from.origin.y) * to.size.height / from.size.height;
+    return p;
+}
 
+CGPoint macdrv_stretch_to_wine(CGPoint point)
+{
+    if (!stretch_window || !CGRectContainsPoint(stretch_full, point)) return point;
+    return map_point(point, stretch_full, stretch_src);
+}
 
+CGPoint macdrv_stretch_from_wine(CGPoint point)
+{
+    if (!stretch_window || !CGRectContainsPoint(CGRectInset(stretch_src, -1, -1), point)) return point;
+    return map_point(point, stretch_src, stretch_full);
+}
+
+CGRect macdrv_stretch_rect_from_wine(CGRect rect)
+{
+    CGPoint a, b;
+    if (!stretch_window || CGRectIsInfinite(rect) || !CGRectContainsRect(CGRectInset(stretch_src, -1, -1), rect)) return rect;
+    a = map_point(rect.origin, stretch_src, stretch_full);
+    b = map_point(CGPointMake(CGRectGetMaxX(rect), CGRectGetMaxY(rect)), stretch_src, stretch_full);
+    return CGRectMake(a.x, a.y, b.x - a.x, b.y - a.y);
+}
